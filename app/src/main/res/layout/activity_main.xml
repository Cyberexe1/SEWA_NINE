<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@android:color/black">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/startup_page"
        android:adjustViewBounds="true"
        android:maxWidth="280dp"
        android:maxHeight="320dp"
        android:scaleType="fitCenter"
        android:contentDescription="NINE"
        android:layout_marginBottom="40dp" />

    <Button
        android:id="@+id/btn_bluetooth"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Start Bluetooth Chat"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#2196F3"
        android:textColor="@android:color/white"
        android:drawableStart="@android:drawable/stat_sys_data_bluetooth"
        android:drawablePadding="12dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No internet required • Peer-to-peer connection"
        android:textSize="12sp"
        android:textColor="#BDBDBD"
        android:layout_marginTop="16dp"
        android:gravity="center" />

</LinearLayout>
