<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:padding="0dp">

    <!-- Header Section (compact, with connection status dot) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@android:color/white"
        android:elevation="4dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/connection_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textSize="16sp"
            android:textColor="#F44336"
            android:layout_marginEnd="8dp"
            android:contentDescription="Connection status" />

        <TextView
            android:id="@+id/username_display"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="You: User"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#2E7D32" />

        <ImageButton
            android:id="@+id/btn_edit_username"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_edit"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Edit name"
            android:padding="6dp"
            android:tint="#2E7D32" />

        <!-- Kept for status logic, hidden from UI -->
        <TextView
            android:id="@+id/status_text"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:text="Bluetooth Chat Ready" />
    </LinearLayout>

    <!-- Connect Button (single tap: listen + become discoverable + scan) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@android:color/white"
        android:elevation="2dp">

        <Button
            android:id="@+id/btn_connect"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Connect"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#4CAF50"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <!-- Devices Section (expands to show found devices) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@android:color/white"
        android:elevation="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📱 Available Devices"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#424242"
            android:layout_marginBottom="6dp" />

        <ListView
            android:id="@+id/device_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#FAFAFA"
            android:divider="#E0E0E0"
            android:dividerHeight="1dp"
            android:padding="4dp" />
    </LinearLayout>

    <!-- Messages Section (priority space, sits directly above the input) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@android:color/white"
        android:elevation="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💬 Messages"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#424242"
            android:layout_marginBottom="6dp" />

        <ListView
            android:id="@+id/message_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#FFFFFF"
            android:divider="#E0E0E0"
            android:dividerHeight="1dp"
            android:padding="8dp"
            android:transcriptMode="alwaysScroll"
            android:stackFromBottom="true" />
    </LinearLayout>

    <!-- Message Input Section (pinned above the keyboard) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#1E1E1E"
        android:elevation="8dp">

        <EditText
            android:id="@+id/message_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Type your message..."
            android:padding="12dp"
            android:background="#2C2C2C"
            android:textColor="#FFFFFF"
            android:textColorHint="#9E9E9E"
            android:textSize="15sp"
            android:layout_marginEnd="8dp"
            android:minHeight="48dp"
            android:maxLines="3"
            android:inputType="textCapSentences|textMultiLine" />

        <Button
            android:id="@+id/btn_send_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Send"
            android:textStyle="bold"
            android:backgroundTint="#4CAF50"
            android:textColor="@android:color/white"
            android:minWidth="80dp"
            android:minHeight="48dp" />
    </LinearLayout>

</LinearLayout>
